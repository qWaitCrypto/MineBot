{
  "name": "cancel_and_query",
  "description": "Cancel flags a running action; query reconciles running, terminal, and unknown states.",
  "steps": [
    {
      "send": {
        "builder": "hello",
        "args": {}
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "HELLO",
        "request_id": "r-1"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "HELLO_ACK",
        "request_id": "r-1",
        "protocol": "fakeplayer-body/1",
        "minecraft_version": "26.1.2",
        "max_request_bytes": 16384,
        "max_requests_per_second": 40,
        "request_types": [
          "ASCEND",
          "BODY_STATE",
          "CANCEL_ACTION",
          "COLLECT_BLOCK",
          "ENTITY_READ",
          "FIND_BLOCKS",
          "HELLO",
          "INVENTORY",
          "MUTATION_VERDICT",
          "NAVIGATE",
          "QUERY_ACTION",
          "RESUME_EVENTS",
          "WORLD_READ"
        ],
        "seq": 1,
        "server_tick": 500,
        "sent_at_ms": 1785000005000
      },
      "expect": [
        {
          "kind": "response",
          "type": "HELLO_ACK",
          "request_type": "HELLO"
        }
      ]
    },
    {
      "send": {
        "builder": "cancel_action",
        "args": {
          "action_id": "nav-0005"
        }
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "CANCEL_ACTION",
        "request_id": "r-2",
        "action_id": "nav-0005"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "CANCEL_ACTION_RESULT",
        "request_id": "r-2",
        "action_id": "nav-0005",
        "state": "cancel_requested",
        "seq": 2,
        "server_tick": 501,
        "sent_at_ms": 1785000005100
      },
      "expect": [
        {
          "kind": "response",
          "type": "CANCEL_ACTION_RESULT",
          "request_type": "CANCEL_ACTION",
          "payload_contains": {
            "state": "cancel_requested"
          }
        }
      ]
    },
    {
      "send": {
        "builder": "query_action",
        "args": {
          "action_id": "nav-0005"
        }
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "QUERY_ACTION",
        "request_id": "r-3",
        "action_id": "nav-0005"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "QUERY_ACTION_RESULT",
        "request_id": "r-3",
        "action_id": "nav-0005",
        "state": "terminal",
        "terminal": {
          "classification": "canceled",
          "reason": "cancel_requested",
          "elapsed_ticks": 44,
          "replans": 0,
          "expanded_nodes": 500,
          "unloaded_touches": 0
        },
        "seq": 3,
        "server_tick": 504,
        "sent_at_ms": 1785000005400
      },
      "expect": [
        {
          "kind": "response",
          "type": "QUERY_ACTION_RESULT",
          "request_type": "QUERY_ACTION",
          "payload_contains": {
            "state": "terminal"
          }
        }
      ]
    },
    {
      "send": {
        "builder": "query_action",
        "args": {
          "action_id": "lost-after-restart"
        }
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "QUERY_ACTION",
        "request_id": "r-4",
        "action_id": "lost-after-restart"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "QUERY_ACTION_RESULT",
        "request_id": "r-4",
        "action_id": "lost-after-restart",
        "state": "unknown",
        "seq": 4,
        "server_tick": 505,
        "sent_at_ms": 1785000005500
      },
      "expect": [
        {
          "kind": "response",
          "type": "QUERY_ACTION_RESULT",
          "request_type": "QUERY_ACTION",
          "payload_contains": {
            "state": "unknown"
          }
        }
      ]
    }
  ],
  "final": {
    "pending_requests": 0
  }
}
