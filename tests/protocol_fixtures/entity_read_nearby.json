{
  "name": "entity_read_nearby",
  "description": "ENTITY_READ preserves stable identity, server-side filters, health, position, distance ordering, and honest top-k truncation.",
  "steps": [
    {
      "send": {"builder": "hello", "args": {}},
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "HELLO",
        "request_id": "r-1"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "HELLO_ACK",
        "request_id": "r-1",
        "protocol": "fakeplayer-body/1",
        "minecraft_version": "26.1.2",
        "max_request_bytes": 16384,
        "max_requests_per_second": 40,
        "request_types": ["ASCEND", "BODY_STATE", "CANCEL_ACTION", "COLLECT_BLOCK", "ENTITY_READ", "FIND_BLOCKS", "HELLO", "INVENTORY", "MUTATION_VERDICT", "NAVIGATE", "QUERY_ACTION", "RESUME_EVENTS", "WORLD_READ"]
      },
      "expect": [{"kind": "response", "type": "HELLO_ACK", "request_type": "HELLO"}]
    },
    {
      "send": {
        "builder": "entity_read",
        "args": {"bot_name": "MineBot_1", "scope": "nearbyEntities", "params": {"radius": 16, "limit": 8, "types": ["player"], "name": "MineBotGuide"}}
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "ENTITY_READ",
        "request_id": "r-2",
        "bot_name": "MineBot_1",
        "scope": "nearbyEntities",
        "params": {"radius": 16, "limit": 8, "types": ["player"], "name": "MineBotGuide"}
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "ENTITY_READ_RESULT",
        "request_id": "r-2",
        "bot": "MineBot_1",
        "scope": "nearbyEntities",
        "missing": false,
        "ok": true,
        "complete": true,
        "data": {
          "center": [10.5, 64.0, -3.5],
          "radius": 16,
          "limit": 8,
          "count": 1,
          "totalMatches": 1,
          "entities": [{"id": "guide-uuid", "type": "minecraft:player", "name": "MineBotGuide", "pos": [12.5, 64.0, -3.5], "health": 20.0, "dist2": 4.0}]
        },
        "uncertainty": [],
        "next": null
      },
      "expect": [{"kind": "response", "type": "ENTITY_READ_RESULT", "request_type": "ENTITY_READ", "payload_contains": {"scope": "nearbyEntities", "complete": true}}]
    },
    {
      "send": {
        "builder": "entity_read",
        "args": {"bot_name": "MineBot_1", "scope": "nearbyEntities", "params": {"radius": 16, "limit": 1}}
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "ENTITY_READ",
        "request_id": "r-3",
        "bot_name": "MineBot_1",
        "scope": "nearbyEntities",
        "params": {"radius": 16, "limit": 1}
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "ENTITY_READ_RESULT",
        "request_id": "r-3",
        "bot": "MineBot_1",
        "scope": "nearbyEntities",
        "missing": false,
        "ok": true,
        "complete": false,
        "data": {
          "center": [10.5, 64.0, -3.5],
          "radius": 16,
          "limit": 1,
          "count": 1,
          "totalMatches": 3,
          "entities": [{"id": "item-uuid", "type": "minecraft:item", "name": "Oak Log", "pos": [11.0, 64.0, -3.5], "health": null, "dist2": 0.25}]
        },
        "uncertainty": [{"reason": "limit_exceeded"}],
        "next": "limit"
      },
      "expect": [{"kind": "response", "type": "ENTITY_READ_RESULT", "request_type": "ENTITY_READ", "payload_contains": {"scope": "nearbyEntities", "complete": false, "next": "limit"}}]
    },
    {
      "send": {
        "builder": "entity_read",
        "args": {"bot_name": "MineBot_1", "scope": "nearbyHostiles", "params": {"radius": 16, "limit": 8}}
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "ENTITY_READ",
        "request_id": "r-4",
        "bot_name": "MineBot_1",
        "scope": "nearbyHostiles",
        "params": {"radius": 16, "limit": 8}
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "ENTITY_READ_RESULT",
        "request_id": "r-4",
        "bot": "MineBot_1",
        "scope": "nearbyHostiles",
        "missing": false,
        "ok": true,
        "complete": true,
        "data": {
          "center": [10.5, 64.0, -3.5],
          "radius": 16,
          "limit": 8,
          "count": 1,
          "totalMatches": 1,
          "entities": [{"id": "zombie-uuid", "type": "minecraft:zombie", "name": "Zombie", "pos": [13.5, 64.0, -3.5], "health": 20.0, "dist2": 9.0}]
        },
        "uncertainty": [],
        "next": null
      },
      "expect": [{"kind": "response", "type": "ENTITY_READ_RESULT", "request_type": "ENTITY_READ", "payload_contains": {"scope": "nearbyHostiles", "complete": true}}]
    }
  ],
  "final": {"pending_requests": 0, "supports": ["ENTITY_READ"]}
}
