        "seq": 1,
        "server_tick": 700,
        "sent_at_ms": 1785000007000
      },
      "expect": [{"kind": "response", "type": "HELLO_ACK", "request_type": "HELLO"}]
    },
    {
      "send": {"builder": "body_state", "args": {"bot_name": "MineBot_1"}},
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "BODY_STATE",
        "request_id": "r-2",
        "bot_name": "MineBot_1"
      }
    },
    {
      "recv": {
