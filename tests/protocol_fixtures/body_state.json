{
  "name": "body_state",
  "description": "BODY_STATE returns the authoritative server-side snapshot the neutral Body contract's get_state() maps; a missing bot is a typed missing snapshot, never fabricated state.",
  "steps": [
    {
      "send": {"builder": "hello", "args": {}},
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "HELLO",
        "request_id": "r-1"
      }
    },
    {
      "recv": {
