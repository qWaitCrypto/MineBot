{
  "name": "engage_entity",
  "description": "ENGAGE_ENTITY locks one hostile target, returns an acknowledgement first, and settles only from a server-observed kill terminal.",
  "steps": [
    {
      "send": {
        "builder": "hello",
        "args": {}
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "HELLO",
        "request_id": "r-1"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "HELLO_ACK",
        "request_id": "r-1",
        "protocol": "fakeplayer-body/1",
        "minecraft_version": "26.1.2",
        "max_request_bytes": 16384,
        "max_requests_per_second": 40,
        "request_types": [
          "ENGAGE_ENTITY",
          "HELLO"
        ]
      },
      "expect": [
        {
          "kind": "response",
          "type": "HELLO_ACK",
          "request_type": "HELLO"
        }
      ]
    },
    {
      "send": {
        "builder": "engage_entity",
        "args": {
          "bot_name": "MineBot_1",
          "action_id": "engage-0001",
          "params": {
            "target_spec": "nearest_hostile",
            "attack_range": 2.0,
            "cooldown_ticks": 10,
            "acquire_radius": 32,
            "timeout_ticks": 400,
            "disengage_health": 6.0
          }
        }
      },
      "expect_message": {
        "channel": "fakeplayer-body",
        "protocol": "fakeplayer-body/1",
        "type": "ENGAGE_ENTITY",
        "request_id": "r-2",
        "bot_name": "MineBot_1",
        "action_id": "engage-0001",
        "target_spec": "nearest_hostile",
        "attack_range": 2.0,
        "cooldown_ticks": 10,
        "acquire_radius": 32,
        "timeout_ticks": 400,
        "disengage_health": 6.0
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "ENGAGE_ENTITY_ACK",
        "request_id": "r-2",
        "action_id": "engage-0001",
        "state": "accepted"
      },
      "expect": [
        {
          "kind": "response",
          "type": "ENGAGE_ENTITY_ACK",
          "request_type": "ENGAGE_ENTITY",
          "payload_contains": {
            "state": "accepted"
          }
        }
      ]
    },
    {
      "recv": {
        "channel": "fakeplayer-body",
        "type": "EVENT",
        "bot": "MineBot_1",
        "seq": 1,
        "tick": 904,
        "event": "action_terminal",
        "action_id": "engage-0001",
        "data": {
          "classification": "completed",
          "reason": "killed",
          "target_id": "husk-uuid",
          "target_health": 0.0,
          "damage_observed": true,
          "attacks": 3,
          "min_attack_interval_ticks": 10
        }
      },
      "expect": [
        {
          "kind": "event",
          "name": "action_terminal",
          "seq": 1,
          "action_id": "engage-0001",
          "data_contains": {
            "classification": "completed",
            "reason": "killed",
            "damage_observed": true
          }
        }
      ]
    }
  ],
  "final": {
    "supports": [
      "ENGAGE_ENTITY"
    ],
    "pending_requests": 0,
    "last_seq": {
      "MineBot_1": 1
    }
  }
}
