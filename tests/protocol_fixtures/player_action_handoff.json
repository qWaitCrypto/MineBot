{
  "name": "player_action_handoff",
  "description": "PLAYER_ACTION handoff completes only with observed receiver inventory growth and carries a pickup receipt.",
  "steps": [
    {
      "send": {"builder": "hello", "args": {}},
      "expect_message": {"channel": "fakeplayer-body", "protocol": "fakeplayer-body/1", "type": "HELLO", "request_id": "r-1"}
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "HELLO_ACK", "request_id": "r-1",
        "protocol": "fakeplayer-body/1", "minecraft_version": "26.1.2",
        "max_request_bytes": 16384, "max_requests_per_second": 40,
        "request_types": ["HELLO", "PLAYER_ACTION"]
      },
      "expect": [{"kind": "response", "type": "HELLO_ACK", "request_type": "HELLO"}]
    },
    {
      "send": {
        "builder": "player_action",
        "args": {
          "bot_name": "MineBot_1", "action_id": "handoff-0001", "action": "handoffItem",
          "params": {"receiver": "MineBotGuide", "item": "minecraft:diamond", "count": 2, "timeout_ticks": 60}
        }
      },
      "expect_message": {
        "channel": "fakeplayer-body", "protocol": "fakeplayer-body/1", "type": "PLAYER_ACTION",
        "request_id": "r-2", "bot_name": "MineBot_1", "action_id": "handoff-0001", "action": "handoffItem",
        "params": {"receiver": "MineBotGuide", "item": "minecraft:diamond", "count": 2, "timeout_ticks": 60}
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "PLAYER_ACTION_ACK", "request_id": "r-2",
        "action_id": "handoff-0001", "state": "accepted"
      },
      "expect": [{"kind": "response", "type": "PLAYER_ACTION_ACK", "request_type": "PLAYER_ACTION", "payload_contains": {"state": "accepted"}}]
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "EVENT", "bot": "MineBot_1", "seq": 1, "tick": 604,
        "event": "action_terminal", "action_id": "handoff-0001",
        "data": {
          "classification": "completed", "reason": "completed", "success": true,
          "receiver": "MineBotGuide", "item": "minecraft:diamond", "requested_count": 2,
          "spawned_count": 2, "source_slot": 18,
          "receiver_count_before": 0, "receiver_count_after": 2,
          "pickup_receipt": {"player": "MineBotGuide", "item": "minecraft:diamond", "count": 2, "tick": 604}
        }
      },
      "expect": [{"kind": "event", "name": "action_terminal", "seq": 1, "data_contains": {"classification": "completed", "spawned_count": 2}}]
    }
  ],
  "final": {"supports": ["PLAYER_ACTION"], "pending_requests": 0, "last_seq": {"MineBot_1": 1}}
}
