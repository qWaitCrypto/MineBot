{
  "name": "lifecycle_and_interrupt",
  "description": "Java Body lifecycle requests remain acknowledgements until server-observed presence and ordered lifecycle events prove the result.",
  "steps": [
    {
      "send": {"builder": "hello", "args": {}},
      "expect_message": {"channel": "fakeplayer-body", "protocol": "fakeplayer-body/1", "type": "HELLO", "request_id": "r-1"}
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "HELLO_ACK", "request_id": "r-1",
        "protocol": "fakeplayer-body/1", "minecraft_version": "26.1.2",
        "max_request_bytes": 16384, "max_requests_per_second": 40,
        "request_types": ["BODY_STATE", "DESPAWN", "EVENT_HEAD", "HELLO", "INTERRUPT", "RESUME_EVENTS", "SPAWN"]
      },
      "expect": [{"kind": "response", "type": "HELLO_ACK", "request_type": "HELLO"}]
    },
    {
      "send": {"builder": "event_head", "args": {"bot_name": "MineBot_1", "proposed_epoch": "client-epoch"}},
      "expect_message": {
        "channel": "fakeplayer-body", "protocol": "fakeplayer-body/1", "type": "EVENT_HEAD",
        "request_id": "r-2", "bot_name": "MineBot_1", "proposed_epoch": "client-epoch"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "EVENT_HEAD_RESULT", "request_id": "r-2",
        "bot": "MineBot_1", "epoch": "server-epoch", "event_seq": 0, "chat_seq": 0,
        "owner": null, "pending_action_count": 0, "tick": 700
      },
      "expect": [{"kind": "response", "type": "EVENT_HEAD_RESULT", "request_type": "EVENT_HEAD"}]
    },
    {
      "send": {
        "builder": "spawn",
        "args": {
          "bot_name": "MineBot_1", "pos": [3, 59, 0], "yaw": 90.0, "pitch": 0.0,
          "gamemode": "survival", "emit_respawned": true
        }
      },
      "expect_message": {
        "channel": "fakeplayer-body", "protocol": "fakeplayer-body/1", "type": "SPAWN",
        "request_id": "r-3", "bot_name": "MineBot_1", "pos": [3, 59, 0],
        "yaw": 90.0, "pitch": 0.0, "gamemode": "survival", "emit_respawned": true
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "EVENT", "bot": "MineBot_1", "seq": 1,
        "tick": 701, "event": "respawned", "data": {"final_pos": [3.0, 59.0, 0.0]}
      },
      "expect": [{"kind": "event", "name": "respawned", "seq": 1}]
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "SPAWN_RESULT", "request_id": "r-3",
        "bot": "MineBot_1", "accepted": true, "present": true, "already_present": false
      },
      "expect": [{"kind": "response", "type": "SPAWN_RESULT", "request_type": "SPAWN", "payload_contains": {"accepted": true, "present": true}}]
    },
    {
      "send": {"builder": "interrupt", "args": {"bot_name": "MineBot_1", "reason": "user_cancel"}},
      "expect_message": {
        "channel": "fakeplayer-body", "protocol": "fakeplayer-body/1", "type": "INTERRUPT",
        "request_id": "r-4", "bot_name": "MineBot_1", "reason": "user_cancel"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "INTERRUPT_RESULT", "request_id": "r-4",
        "bot": "MineBot_1", "accepted": true, "complete": true, "owner_action_id": null
      },
      "expect": [{"kind": "response", "type": "INTERRUPT_RESULT", "request_type": "INTERRUPT", "payload_contains": {"accepted": true, "complete": true}}]
    },
    {
      "send": {"builder": "despawn", "args": {"bot_name": "MineBot_1"}},
      "expect_message": {
        "channel": "fakeplayer-body", "protocol": "fakeplayer-body/1", "type": "DESPAWN",
        "request_id": "r-5", "bot_name": "MineBot_1"
      }
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "EVENT", "bot": "MineBot_1", "seq": 2,
        "tick": 702, "event": "bodyMissing", "data": {"lastPos": [3.0, 59.0, 0.0], "reason": "despawn"}
      },
      "expect": [{"kind": "event", "name": "bodyMissing", "seq": 2}]
    },
    {
      "recv": {
        "channel": "fakeplayer-body", "type": "DESPAWN_RESULT", "request_id": "r-5",
        "bot": "MineBot_1", "accepted": true, "missing": true, "already_missing": false
      },
      "expect": [{"kind": "response", "type": "DESPAWN_RESULT", "request_type": "DESPAWN", "payload_contains": {"accepted": true, "missing": true}}]
    }
  ],
  "final": {"supports": ["BODY_STATE", "DESPAWN", "EVENT_HEAD", "HELLO", "INTERRUPT", "RESUME_EVENTS", "SPAWN"], "pending_requests": 0, "last_seq": {"MineBot_1": 2}}
}
