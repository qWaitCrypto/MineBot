                        'facts': {'decision': {'choice': 'interrupt'}}}}
                return {'success': True, 'reason': 'equipped' if tool == 'equip_item' else 'arrived'}
            async def state():
                return {'position': [220, 121, 220], 'health': 20, 'selected_item': 'stone_sword'}
            async def judge(**kw):
                questions.append(kw['question'])
